      "inputSchema": {
        "type": "object",
        "properties": {
          "X-Request-Id": {
            "type": "string",
            "maxLength": 128,
            "example": "mvp-req-id-a1b2c3d4"
          },
          "MCP-Protocol-Version": {
            "type": "string",
            "example": "2025-03-26"
          }
        }
      }
    },
    {
      "name": "mcpJsonRpc",
      "description": "Streamable HTTP JSON-RPC (POST-only MVP)",
      "inputSchema": {
        "type": "object",
        "properties": {
          "X-Request-Id": {
            "type": "string",
            "maxLength": 128,
            "example": "mvp-req-id-a1b2c3d4"
          },
          "MCP-Protocol-Version": {
            "type": "string",
            "example": "2025-03-26"
          },
          "Mcp-Session-Id": {
            "type": "string",
            "format": "uuid"
          },
          "jsonrpc": {
            "type": "string",
            "example": "2.0"
          },
          "id": {
            "description": "Request id (omit for notifications)",
            "nullable": true
          },
          "method": {
            "type": "string",
            "example": "initialize"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    {
      "name": "mcpSessionDelete",
      "description": "Terminate Streamable HTTP session",
      "inputSchema": {
        "type": "object",
        "properties": {
          "X-Request-Id": {
            "type": "string",
            "maxLength": 128,
            "example": "mvp-req-id-a1b2c3d4"
          },
          "MCP-Protocol-Version": {
            "type": "string",
            "example": "2025-03-26"
          },
