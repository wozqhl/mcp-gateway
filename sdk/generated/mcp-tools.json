        ]
      }
    },
    {
      "name": "auditQuery",
      "description": "Query audit events (JSON)",
      "inputSchema": {
        "type": "object",
        "properties": {
          "X-Request-Id": {
            "type": "string",
            "maxLength": 128,
            "example": "mvp-req-id-a1b2c3d4"
          },
          "tenant": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "default": 50
          },
          "since": {
            "type": "string",
            "format": "date-time"
          },
          "until": {
            "type": "string",
            "format": "date-time"
          },
          "redact": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "auditExport",
      "description": "Download audit export pack (JSON or CSV; optional gzip)",
      "inputSchema": {
        "type": "object",
        "properties": {
          "X-Request-Id": {
            "type": "string",
            "maxLength": 128,
            "example": "mvp-req-id-a1b2c3d4"
          },
          "format": {
            "type": "string",
            "enum": [
              "json",
              "csv"
            ],
            "default": "json"
          },
          "tenant": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "limit": {
            "type": "integer"
          },
          "since": {
            "type": "string",
            "format": "date-time"
          },
          "until": {
            "type": "string",
            "format": "date-time"
          },
          "redact": {
            "type": "string"
          },
          "gzip": {
            "type": "string",
            "enum": [
              "0",
              "1",
              "true",
              "false"
            ]
          }
        }
      }
    },
